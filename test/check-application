import testlib

# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and RHEL dist-git gating
# They must not permanently change any file or configuration on the system in a way that influences other tests.


@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def testBasic(self):
        b = self.browser
        m = self.machine

        # the page must be reachable even when tailscale is not installed;
        # it is expected to show a proper error message instead of crashing
        self.login_and_go("/tailscale")
        b.wait_in_text("h1", "Tailscale")

        # an error alert about the missing tailscale binary is expected on
        # machines without tailscale; the page must not stay on "Loading"
        b.wait_visible(".pf-v5-c-alert")

        # install tailscale and reload
        if m.image == "ubuntu-stable":
            m.execute("snap install tailscale || true")
        else:
            m.execute("dnf install -y tailscale || apt-get install -y tailscale || true")
        b.reload()
        b.wait_in_text(".pf-v5-c-card", "Connection")


if __name__ == '__main__':
    testlib.test_main()
